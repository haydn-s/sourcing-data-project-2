# Copy these settings into Streamlit Community Cloud's Secrets field.
# For local development, run with QUIZ_STORAGE=local instead (no token needed).
[storage]
backend = "github"

[github]
repository = "haydn-s/sourcing-data-project-2"
# Keep responses on a different branch from the deployed app to avoid reloads.
branch = "data-collection-scaffolding"
token = "REPLACE_WITH_A_FINE_GRAINED_TOKEN"
